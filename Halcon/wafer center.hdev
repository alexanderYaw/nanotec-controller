<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="26.05.0.0">
<procedure name="main">
<interface/>
<body>
<c>* Radially the scene runs wafer - bevel - gap - chuck. The edge wanted is the unlit gap against</c>
<c>* the CHUCK, the chuck being the in-focus surface and so the more repeatable of the two; the</c>
<c>* gap's other boundary, against the bevel ~345 px away, is the trap, and picking it biases the</c>
<c>* fitted radius by the gap's width on every sample.</c>
<c>* Thresholding the BRIGHT side cannot work here - it finds the BEVEL, which Otsu reads as dark</c>
<c>* and which is about as wide as the gap, so no closing radius separates them. So the dark</c>
<c>* OFF-WAFER side is segmented instead, and step 5 decides which of its two boundaries is the rim.</c>
<c>* Cut is a two-stage Otsu: a single Otsu lands between wafer and everything else, with the bevel</c>
<c>* below it, so Otsu is run AGAIN over that darker population alone. Both stages are relative, so</c>
<c>* both track exposure.</c>
<c>* SeverRadius opens AFTER the closing, to cut off the dendritic tendrils that CloseRadius grows</c>
<c>* when it bridges the chuck's machined gashes into the band. It has to come after, not instead</c>
<c>* of a bigger CleanRadius, which would leave dust specks too big for CloseRadius to fill.</c>
<c>* Deliberately NO fill_up, unlike the chuck script: if the dark region ever enclosed the wafer,</c>
<c>* filling would swallow the wafer whole and the rim would vanish from the outline.</c>
<c>* WaferIsBrighter: 0 flips which end of the histogram gets re-split, if the lighting inverts.</c>
<l>CleanRadius := 7</l>
<l>CloseRadius := 21</l>
<l>SeverRadius := 35</l>
<l>MinArea := 2e5</l>
<l>MaxMeanFraction := 0.6</l>
<l>FrameMargin := 2</l>
<l>SideProbeRadius := 50</l>
<l>MaxSideContrast := 0.80</l>
<l>MinCollarArea := 5000</l>
<l>SideGrowRadius := 2</l>
<l>WaferIsBrighter := 1</l>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260803_175836_162.bmp')</l>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260804_114724_720.bmp')</l>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260804_135114_498.bmp')</l>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260804_135135_136.bmp')</l>
<c>* Step 5 test frame - its collar breaks into 6 pieces.</c>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260804_114358_183.bmp')</l>
<c>* SeverRadius test frame - compare step 4 with SeverRadius 0 and 35.</c>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260805_111803_054.bmp')</l>
<l>read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260805_111803_054.bmp')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>dev_open_window (0, 0, 750, 500, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>disp_message (WindowHandle, '0: input frame  ' + Width + 'x' + Height, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 1. Single-channel byte image. Mono passes through; a colour frame yields its RED channel. The</c>
<c>*    convert to 'byte' is a no-op on 8-bit captures but keeps a deeper camera in step with the</c>
<c>*    C# detector - gray_histo bins differently.</c>
<l>count_channels (Image, Channels)</l>
<l>if (Channels &gt;= 3)</l>
<l>    access_channel (Image, GrayRaw, 1)</l>
<l>else</l>
<l>    copy_image (Image, GrayRaw)</l>
<l>endif</l>
<l>convert_image_type (GrayRaw, Gray, 'byte')</l>
<l>dev_display (Gray)</l>
<l>disp_message (WindowHandle, '1: grey (' + Channels + ' channel(s) in)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 2. Stage-1 Otsu over the whole histogram - the cut that is NOT wanted, computed only to</c>
<c>*    bound stage 2.</c>
<l>get_domain (Gray, Domain)</l>
<l>gray_histo (Domain, Gray, Histo, HistoRelative)</l>
<l>Lo := 0</l>
<l>Hi := 255</l>
<c>*    The 1.0 * is load-bearing: gray_histo returns INTEGER counts and HALCON's / truncates on</c>
<c>*    integer tuples, which would floor the class means and drift the threshold.</c>
<l>Bins := 1.0 * [Lo:Hi]</l>
<l>Sub := 1.0 * Histo[Lo:Hi]</l>
<l>Total := sum(Sub)</l>
<l>Moment := sum(Bins * Sub)</l>
<l>tuple_cumul (Sub, WeightLow)</l>
<l>tuple_cumul (Bins * Sub, MomentLow)</l>
<l>WeightHigh := Total - WeightLow</l>
<l>tuple_max2 (WeightLow, 1, WeightLowSafe)</l>
<l>tuple_max2 (WeightHigh, 1, WeightHighSafe)</l>
<l>MeanLow := MomentLow / WeightLowSafe</l>
<l>MeanHigh := (Moment - MomentLow) / WeightHighSafe</l>
<l>Between := (WeightLow / Total) * (WeightHigh / Total) * (MeanLow - MeanHigh) * (MeanLow - MeanHigh)</l>
<l>tuple_sort_index (Between, BetweenIdx)</l>
<l>Split := Lo + BetweenIdx[|BetweenIdx| - 1]</l>
<l>threshold (Gray, Stage1Dark, 0, Split)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('red')</l>
<l>dev_display (Stage1Dark)</l>
<l>disp_message (WindowHandle, '2: stage-1 Otsu = ' + Split + '; everything at or below it in red - note the BEVEL is in there, which is why this cut is not the answer', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 3. Stage-2 Otsu over that darker population</c>
<l>if (WaferIsBrighter)</l>
<l>    Lo := 0</l>
<l>    Hi := Split</l>
<l>else</l>
<l>    Lo := Split</l>
<l>    Hi := 255</l>
<l>endif</l>
<l>Bins := 1.0 * [Lo:Hi]</l>
<l>Sub := 1.0 * Histo[Lo:Hi]</l>
<l>Total := sum(Sub)</l>
<l>Moment := sum(Bins * Sub)</l>
<l>tuple_cumul (Sub, WeightLow)</l>
<l>tuple_cumul (Bins * Sub, MomentLow)</l>
<l>WeightHigh := Total - WeightLow</l>
<l>tuple_max2 (WeightLow, 1, WeightLowSafe)</l>
<l>tuple_max2 (WeightHigh, 1, WeightHighSafe)</l>
<l>MeanLow := MomentLow / WeightLowSafe</l>
<l>MeanHigh := (Moment - MomentLow) / WeightHighSafe</l>
<l>Between := (WeightLow / Total) * (WeightHigh / Total) * (MeanLow - MeanHigh) * (MeanLow - MeanHigh)</l>
<l>tuple_sort_index (Between, BetweenIdx)</l>
<l>Cut := Lo + BetweenIdx[|BetweenIdx| - 1]</l>
<l>if (WaferIsBrighter)</l>
<l>    threshold (Gray, OffWaferRaw, 0, Cut)</l>
<l>else</l>
<l>    threshold (Gray, OffWaferRaw, Cut, 255)</l>
<l>endif</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('red')</l>
<l>dev_display (OffWaferRaw)</l>
<l>disp_message (WindowHandle, '3: stage-2 Otsu over bins [' + Lo + ',' + Hi + '] = ' + Cut + ' - the off-wafer side (red), before cleanup. The bevel should NOT be red now.', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 4. Clean up, then keep only the components BOTH big enough AND black enough to be the gap.</c>
<l>opening_circle (OffWaferRaw, OffWaferOpened, CleanRadius)</l>
<l>closing_circle (OffWaferOpened, OffWaferClosed, CloseRadius)</l>
<l>opening_circle (OffWaferClosed, OffWaferSevered, SeverRadius)</l>
<l>connection (OffWaferSevered, OffWaferParts)</l>
<l>count_obj (OffWaferParts, NumParts)</l>
<l>select_shape (OffWaferParts, BigEnough, 'area', 'and', MinArea, 1e9)</l>
<l>count_obj (BigEnough, NumBig)</l>
<l>if (WaferIsBrighter)</l>
<l>    MeanLoLimit := 0</l>
<l>    MeanHiLimit := MaxMeanFraction * Cut</l>
<l>else</l>
<l>    MeanLoLimit := 255 - MaxMeanFraction * (255 - Cut)</l>
<l>    MeanHiLimit := 255</l>
<l>endif</l>
<l>select_gray (BigEnough, Gray, OffWafer, 'mean', 'and', MeanLoLimit, MeanHiLimit)</l>
<l>count_obj (OffWafer, NumKept)</l>
<l>Msg := '4: ' + NumParts + ' component(s), ' + NumBig + ' over ' + MinArea + ' px2, ' + NumKept + ' of those within mean [' + MeanLoLimit$'.0f' + ',' + MeanHiLimit$'.0f' + '] (green)'</l>
<l>if (NumBig &gt;= 1)</l>
<l>    area_center (BigEnough, KeptArea, KeptRow, KeptCol)</l>
<l>    intensity (BigEnough, Gray, KeptMean, KeptDev)</l>
<l>    for K := 0 to NumBig - 1 by 1</l>
<l>        if (KeptMean[K] &gt;= MeanLoLimit and KeptMean[K] &lt;= MeanHiLimit)</l>
<l>            Verdict := '  KEEP'</l>
<l>        else</l>
<l>            Verdict := '  drop'</l>
<l>        endif</l>
<l>        Msg := [Msg, '    ' + (K + 1) + ': area ' + KeptArea[K]$'10.0f' + '   mean ' + KeptMean[K]$'6.1f' + '   mean/Cut ' + (KeptMean[K] / Cut)$'5.2f' + Verdict]</l>
<l>    endfor</l>
<l>endif</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (OffWafer)</l>
<l>disp_message (WindowHandle, Msg, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<l>if (NumKept &lt; 1)</l>
<l>    dev_display (Gray)</l>
<l>    disp_message (WindowHandle, 'REJECTED: no component is both large enough and dark enough to be the gap. Usually right - either the wafer fills the view or there is no rim in this frame at all. If a frame that plainly HAS a rim lands here, read the mean/Cut column above: if the gap is listed but dropped, raise MaxMeanFraction; if it is not listed at all, the problem is upstream at step 3.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 5. WHICH SIDE of the gap is the chuck. Nearest-to-the-crosshair alone picks whichever side the</c>
<c>*    crosshair happens to sit on, and nothing downstream catches the mistake.</c>
<c>*    BRIGHTNESS decides it: the bevel throws a near-saturated glint, the chuck is diffuse and</c>
<c>*    mid-grey, so keep the DARKER collar. Compare the two LARGEST pieces only, and COMPARE them</c>
<c>*    rather than thresholding - a ragged outline breaks the collar into 6-13 fragments, and any</c>
<c>*    cut-off against the brightest admits slivers from BOTH sides. Texture cannot decide it: the</c>
<c>*    glint is pitted, so the wafer collar is the rougher of the two, and that polarity belongs to</c>
<c>*    the current optics anyway.</c>
<c>*    One flank in view is NO evidence about which boundary faces the chuck, so the region is</c>
<c>*    dropped rather than guessed at.</c>
<c>*    FLANK CONTRAST is the third filter, and the one that matters when the crosshair sits over the</c>
<c>*    CHUCK: a rim gap has glint on one flank and chuck on the other, a shadow trough has chuck on</c>
<c>*    both and reads near 1.0. Nothing else separates them once a trough is near the crosshair.</c>
<c>*    All of this runs PER REGION - merging first would let one trough contribute boundary.</c>
<l>gen_empty_region (RimRing)</l>
<l>Msg := '5: flanks per candidate region, collar radius ' + SideProbeRadius</l>
<l>NumRim := 0</l>
<l>for R := 1 to NumKept by 1</l>
<l>    select_obj (OffWafer, OneGap, R)</l>
<l>    dilation_circle (OneGap, GapGrown, SideProbeRadius)</l>
<l>    difference (GapGrown, OneGap, Collar)</l>
<l>    connection (Collar, CollarParts)</l>
<l>    select_shape (CollarParts, Sides, 'area', 'and', MinCollarArea, 1e9)</l>
<l>    count_obj (Sides, NumSides)</l>
<l>    if (NumSides &lt; 2)</l>
<l>        Msg := [Msg, '    r' + R + ': only ' + NumSides + ' flank - drop (wafer side out of view; nothing says which boundary faces the chuck)']</l>
<l>        continue</l>
<l>    endif</l>
<c>*        The two largest pieces are the flanks; sorted ascending, so they are the last two.</c>
<l>    area_center (Sides, SideArea, SideRow, SideCol)</l>
<l>    intensity (Sides, Gray, SideMean, SideDev)</l>
<l>    tuple_sort_index (SideArea, AreaIdx)</l>
<l>    Biggest := AreaIdx[|AreaIdx| - 1] + 1</l>
<l>    Next := AreaIdx[|AreaIdx| - 2] + 1</l>
<l>    FlankLo := min([SideMean[Biggest - 1],SideMean[Next - 1]])</l>
<l>    FlankHi := max([SideMean[Biggest - 1],SideMean[Next - 1]])</l>
<l>    Contrast := FlankLo / FlankHi</l>
<l>    Detail := ' (' + NumSides + ' piece(s), two largest ' + SideArea[Biggest - 1]$'.0f' + ' and ' + SideArea[Next - 1]$'.0f' + ' px2)'</l>
<l>    if (Contrast &gt; MaxSideContrast)</l>
<l>        Msg := [Msg, '    r' + R + ': flanks ' + FlankLo$'6.1f' + ' /' + FlankHi$'6.1f' + '   contrast ' + Contrast$'5.2f' + '  DROP - trough, chuck on both flanks' + Detail]</l>
<l>        continue</l>
<l>    endif</l>
<l>    if (SideMean[Biggest - 1] &lt;= SideMean[Next - 1])</l>
<l>        ChuckIdx := Biggest</l>
<l>    else</l>
<l>        ChuckIdx := Next</l>
<l>    endif</l>
<l>    select_obj (Sides, ChuckSideCollar, ChuckIdx)</l>
<l>    dilation_circle (ChuckSideCollar, ChuckSide, SideGrowRadius)</l>
<l>    boundary (OneGap, GapBorder, 'inner')</l>
<l>    intersection (GapBorder, ChuckSide, RimPart)</l>
<l>    union2 (RimRing, RimPart, RimGrown)</l>
<l>    copy_obj (RimGrown, RimRing, 1, 1)</l>
<l>    NumRim := NumRim + 1</l>
<l>    Msg := [Msg, '    r' + R + ': flanks ' + FlankLo$'6.1f' + ' /' + FlankHi$'6.1f' + '   contrast ' + Contrast$'5.2f' + '  KEEP - rim gap, chuck side is flank ' + ChuckIdx + Detail]</l>
<l>endfor</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (RimRing)</l>
<l>disp_message (WindowHandle, Msg, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<l>if (NumRim &lt; 1)</l>
<l>    dev_display (Gray)</l>
<l>    disp_message (WindowHandle, 'FAILED: no region looks like a rim gap - every candidate had chuck on both flanks, or only one flank in view. Usually right. If a frame that plainly HAS a rim lands here, read the contrast column: near 1.0 on the real gap means the wafer side is not being sampled, so check SideProbeRadius against the bevel width.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 6. Drop the stretches of that ring which merely run along the image frame. This is also what</c>
<c>*    makes a wholly off-wafer frame fail rather than report the frame edge as a rim point.</c>
<l>gen_rectangle1 (Inner, FrameMargin, FrameMargin, Height - 1 - FrameMargin, Width - 1 - FrameMargin)</l>
<l>intersection (RimRing, Inner, Rim)</l>
<l>area_center (Rim, RimArea, RimRow, RimCol)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (Rim)</l>
<l>disp_message (WindowHandle, '6: rim ring on the chuck side, ' + FrameMargin + ' px inside the frame - ' + RimArea + ' px', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<l>if (RimArea &lt; 1)</l>
<l>    dev_display (Gray)</l>
<l>    disp_message (WindowHandle, 'FAILED: nothing left of the boundary once the frame runs and the bevel side were dropped, so this frame is entirely off the wafer.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 7. Edge point closest to the image centre - the crosshair - over what survived.</c>
<l>CenterRow := Height / 2.0</l>
<l>CenterCol := Width / 2.0</l>
<l>get_region_points (Rim, AllRow, AllCol)</l>
<l>Dist := sqrt((AllRow - CenterRow) * (AllRow - CenterRow) + (AllCol - CenterCol) * (AllCol - CenterCol))</l>
<l>tuple_sort_index (Dist, SortIdx)</l>
<l>Nearest := SortIdx[0]</l>
<l>NearRow := AllRow[Nearest]</l>
<l>NearCol := AllCol[Nearest]</l>
<l>NearDist := Dist[Nearest]</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (Rim)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (2)</l>
<l>gen_cross_contour_xld (CenterCross, CenterRow, CenterCol, 60, 0.785)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (CenterCross)</l>
<l>gen_cross_contour_xld (NearCross, NearRow, NearCol, 60, 0.785)</l>
<l>dev_set_color ('red')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (NearCross)</l>
<l>disp_message (WindowHandle, '7: nearest edge point to centre = (' + NearRow$'.1f' + ', ' + NearCol$'.1f' + '),  dist=' + NearDist$'.1f' + ' px', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
