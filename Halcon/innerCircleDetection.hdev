<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="26.05.0.0">
<procedure name="main">
<interface/>
<body>
<c>* Inner-circle detector - HDevelop tuning script. Mirrors Vision/InnerCircleDetector.cs.</c>
<c>* Step with Run (F5); it pauses at each stop().</c>
<c>* Finds the boundary between the bright, in-focus chuck FACE and the near-black region beside</c>
<c>* it, and reports the point on it nearest the image centre - the same output contract as</c>
<c>* "chuck edge detector.hdev".</c>
<c>* A different pipeline from the outer edge, not a retune of it: here grey level separates the</c>
<c>* two sides outright (a ~219-level gap) and focus energy is actively WRONG, since the flat</c>
<c>* SATURATED face has no gradient and reads as blurry. So none of the focus machinery is reused.</c>
<c>* BrightThreshold is deliberately FIXED rather than Otsu: the two levels are set by the</c>
<c>* illumination and do not move with framing, and a fixed cut makes step 3b honest.</c>
<c>* The fitted circle's CENTRE LIES OUTSIDE THE FRAME (r ~4600 px) - expect a radius larger than</c>
<c>* the frame and do not read it as a failure.</c>
<c>* Tuned on one frame (capture_20260731_160143_116.bmp); the margins are provisional.</c>
<l>SmoothWindow := 1</l>
<l>BrightThreshold := 80</l>
<l>CloseRadius := 105</l>
<l>OpenRadius := 15</l>
<l>MinArcLength := 800</l>
<l>BorderMargin := 3</l>
<l>MinFacePercent := 2.0</l>
<l>MaxFacePercent := 98.0</l>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260731_160143_116.bmp')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>dev_open_window (0, 0, 750, 500, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>disp_message (WindowHandle, '0: input frame  ' + Width + 'x' + Height, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 1. Single channel. Mono passes through; a colour frame yields its RED channel.</c>
<l>count_channels (Image, Channels)</l>
<l>if (Channels &gt;= 3)</l>
<l>    access_channel (Image, Gray, 1)</l>
<l>else</l>
<l>    copy_image (Image, Gray)</l>
<l>endif</l>
<l>min_max_gray (Gray, Gray, 0, GrayMin, GrayMax, GrayRange)</l>
<l>dev_display (Gray)</l>
<l>disp_message (WindowHandle, '1: grey (' + Channels + ' channel(s) in), range ' + GrayMin + '-' + GrayMax, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 2. Optional smoothing before the cut - OFF by default; the first thing to try if a future</c>
<c>*    capture speckles.</c>
<l>if (SmoothWindow &gt; 1)</l>
<l>    mean_image (Gray, GraySmoothed, SmoothWindow, SmoothWindow)</l>
<l>else</l>
<l>    copy_image (Gray, GraySmoothed)</l>
<l>endif</l>
<l>dev_display (GraySmoothed)</l>
<l>disp_message (WindowHandle, '2: smoothing ' + (SmoothWindow &gt; 1 ? '' + SmoothWindow + 'x' + SmoothWindow : 'OFF'), 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 3. Split the two sides on grey level. LOOK HERE if the result is wrong - the green region</c>
<c>*    should be the whole bright face and nothing else, with the pitted lip left for step 4.</c>
<c>*    Otsu is available (BrightThreshold := -1) but is not the default.</c>
<l>if (BrightThreshold &lt; 0)</l>
<l>    binary_threshold (GraySmoothed, FaceRaw, 'max_separability', 'light', UsedThreshold)</l>
<l>else</l>
<l>    UsedThreshold := BrightThreshold</l>
<l>    threshold (GraySmoothed, FaceRaw, UsedThreshold, 255)</l>
<l>endif</l>
<l>area_center (FaceRaw, FaceRawArea, FaceRawRow, FaceRawCol)</l>
<l>FacePercent := 100.0 * sum(FaceRawArea) / (Width * Height)</l>
<l>dev_display (GraySmoothed)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (FaceRaw)</l>
<l>disp_message (WindowHandle, '3: grey &gt;= ' + UsedThreshold + ' (green) = the bright face, before cleanup - ' + FacePercent$'.1f' + '% of the frame', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 3b. Reject the frame when only ONE of the two populations is present, i.e. the boundary is</c>
<c>*     not in view. The fixed cut makes this simple: an all-dark frame yields an EMPTY region</c>
<c>*     and an all-bright frame the whole frame. The bounds are wide on purpose - they catch NO</c>
<c>*     BOUNDARY AT ALL, they do not police framing.</c>
<l>if (FacePercent &lt; MinFacePercent or FacePercent &gt; MaxFacePercent)</l>
<l>    dev_display (Gray)</l>
<l>    disp_message (WindowHandle, 'REJECTED: no boundary in view - the bright face is ' + FacePercent$'.1f' + '% of the frame, outside ' + MinFacePercent$'.0f' + '-' + MaxFacePercent$'.0f' + '%. The frame is all face or all dark region; move the stage until the boundary crosses the view.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 4. Clean up to ONE solid region. The closing repairs the pits ON the lip, which is where</c>
<c>*    nearly all of the accuracy is won; fill_up disposes of the ones inside the face.</c>
<l>closing_circle (FaceRaw, FaceClosed, CloseRadius)</l>
<l>opening_circle (FaceClosed, FaceOpened, OpenRadius)</l>
<l>connection (FaceOpened, FaceParts)</l>
<l>count_obj (FaceParts, NumParts)</l>
<l>select_shape_std (FaceParts, FaceBiggest, 'max_area', 70)</l>
<l>fill_up (FaceBiggest, Face)</l>
<l>area_center (Face, FaceArea, FaceRow, FaceCol)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (Face)</l>
<l>disp_message (WindowHandle, '4: solid face - ' + NumParts + ' component(s), largest covers ' + (100.0 * FaceArea / (Width * Height))$'.1f' + '% of the frame', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 5. The inner circle edge = that region's outline, minus the stretches that merely run along</c>
<c>*    the image frame. The clip severs those runs; the length filter drops the stubs it leaves.</c>
<l>gen_contour_region_xld (Face, RegionBorder, 'border')</l>
<l>clip_contours_xld (RegionBorder, ClippedBorder, BorderMargin, BorderMargin, Height - 1 - BorderMargin, Width - 1 - BorderMargin)</l>
<l>count_obj (ClippedBorder, NumClipped)</l>
<l>select_contours_xld (ClippedBorder, EdgeArcs, 'contour_length', MinArcLength, 1e9, -0.5, 0.5)</l>
<l>count_obj (EdgeArcs, NumArcs)</l>
<l>dev_display (Gray)</l>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (EdgeArcs)</l>
<l>disp_message (WindowHandle, '5: outline clipped into ' + NumClipped + ' piece(s), ' + NumArcs + ' longer than ' + MinArcLength + ' px (green)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<l>if (NumArcs &lt; 1)</l>
<l>    dev_display (GraySmoothed)</l>
<l>    disp_message (WindowHandle, 'FAILED: no arc survived. Check step 3 - if the face came out as the whole frame or as nothing, the boundary is not in view and step 3b should have caught it.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 6. Circle fitted to the longest arc - a sanity read-out, not part of the result, and the only</c>
<c>*    check that the arc found is the CIRCLE and not some other two-tone boundary. The tuning</c>
<c>*    frame gives 4.06 px RMS; a residual in the tens means suspect CloseRadius first.</c>
<l>length_xld (EdgeArcs, ArcLengths)</l>
<l>tuple_sort_index (ArcLengths, LengthIdx)</l>
<l>select_obj (EdgeArcs, MainArc, LengthIdx[|LengthIdx| - 1] + 1)</l>
<l>fit_circle_contour_xld (MainArc, 'geohuber', -1, 0, 0, 3, 2, CircRow, CircCol, CircRadius, CircStartPhi, CircEndPhi, CircPointOrder)</l>
<l>get_contour_xld (MainArc, MainRow, MainCol)</l>
<l>Residual := sqrt((MainRow - CircRow) * (MainRow - CircRow) + (MainCol - CircCol) * (MainCol - CircCol)) - CircRadius</l>
<l>tuple_mean (Residual * Residual, MeanSquare)</l>
<l>FitRms := sqrt(MeanSquare)</l>
<l>dev_display (Gray)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (MainArc)</l>
<l>gen_circle_contour_xld (FitCircle, CircRow, CircCol, CircRadius, CircStartPhi, CircEndPhi, CircPointOrder, 1.0)</l>
<l>dev_set_color ('cyan')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (FitCircle)</l>
<l>disp_message (WindowHandle, '6: longest arc = ' + ArcLengths[LengthIdx[|LengthIdx| - 1]]$'.0f' + ' px; fitted circle r=' + CircRadius$'.0f' + ' px at (' + CircRow$'.0f' + ', ' + CircCol$'.0f' + '), residual ' + FitRms$'.1f' + ' px RMS', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 7. Edge point closest to the image centre - the value the host consumes.</c>
<l>CenterRow := Height / 2.0</l>
<l>CenterCol := Width / 2.0</l>
<l>AllRow := []</l>
<l>AllCol := []</l>
<l>for K := 1 to NumArcs by 1</l>
<l>    select_obj (EdgeArcs, OneContour, K)</l>
<l>    get_contour_xld (OneContour, ContRow, ContCol)</l>
<l>    AllRow := [AllRow, ContRow]</l>
<l>    AllCol := [AllCol, ContCol]</l>
<l>endfor</l>
<l>Dist := sqrt((AllRow - CenterRow) * (AllRow - CenterRow) + (AllCol - CenterCol) * (AllCol - CenterCol))</l>
<l>tuple_sort_index (Dist, SortIdx)</l>
<l>Nearest := SortIdx[0]</l>
<l>NearRow := AllRow[Nearest]</l>
<l>NearCol := AllCol[Nearest]</l>
<l>NearDist := Dist[Nearest]</l>
<l>dev_display (Image)</l>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (EdgeArcs)</l>
<l>gen_cross_contour_xld (CenterCross, CenterRow, CenterCol, 60, 0.785)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (CenterCross)</l>
<l>gen_cross_contour_xld (NearCross, NearRow, NearCol, 60, 0.785)</l>
<l>dev_set_color ('red')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (NearCross)</l>
<l>disp_message (WindowHandle, '7: nearest edge point to centre = (' + NearRow$'.1f' + ', ' + NearCol$'.1f' + '),  dist=' + NearDist$'.1f' + ' px', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
