<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="26.05.0.0">
<procedure name="main">
<interface/>
<body>
<c>* Chuck-edge detector - HDevelop tuning script. Step with Run (F5); it pauses at each stop().</c>
<c>* Across the rim there are three zones: out-of-focus bright background, a near-black BAND, and</c>
<c>* the in-focus chuck face. The edge reported is the OUTER one - band against background.</c>
<c>* Two cues are needed. FOCUS separates the chuck face from everything outside it (both are</c>
<c>* nearly the same brightness, so grey level cannot), but its outline is the INNER edge. GREY</c>
<c>* LEVEL then adds the near-black band; the union's outline is the outer edge.</c>
<l>SobelWidth := 3</l>
<l>EnergyWindow := 41</l>
<l>CloseRadius := 65</l>
<l>OpenRadius := 25</l>
<l>MinArcLength := 800</l>
<l>BorderMargin := 3</l>
<l>ManualThreshold := -1</l>
<l>MinFocusEnergy := 15</l>
<l>SmoothWindow := 21</l>
<l>DarkThreshold := 30</l>
<l>BandGuideRadius := 100</l>
<l>BandCloseRadius := 15</l>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260731_143559_245.bmp')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>dev_open_window (0, 0, 750, 500, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>disp_message (WindowHandle, '0: input frame  ' + Width + 'x' + Height, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 1. Single channel. Mono passes through; a colour frame yields its RED channel.</c>
<l>count_channels (Image, Channels)</l>
<l>if (Channels &gt;= 3)</l>
<l>    access_channel (Image, Gray, 1)</l>
<l>else</l>
<l>    copy_image (Image, Gray)</l>
<l>endif</l>
<l>dev_display (Gray)</l>
<l>disp_message (WindowHandle, '1: grey (' + Channels + ' channel(s) in)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 2. Focus-energy map: gradient magnitude pooled over EnergyWindow. Bright = in focus. The two</c>
<c>*    sides must come out cleanly different, with the boundary following the rim.</c>
<l>sobel_amp (Gray, Amp, 'sum_abs', SobelWidth)</l>
<l>mean_image (Amp, Energy, EnergyWindow, EnergyWindow)</l>
<c>*    0.1% percentile, not the true maximum, so a hot pixel cannot stand in for a sharp area.</c>
<l>min_max_gray (Energy, Energy, 0.1, EnergyMin, EnergyPeak, EnergyRange)</l>
<l>dev_display (Energy)</l>
<l>disp_message (WindowHandle, '2: focus energy (bright=in focus, dark=blurry), 0.1-99.9% range ' + EnergyMin$'.1f' + '-' + EnergyPeak$'.1f', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 2b. Reject the frame if NOTHING in it is in focus. Needed because step 3 is a RELATIVE split:</c>
<c>*     Otsu always returns a threshold, so a wholly defocused frame runs to completion and</c>
<c>*     reports a confident, wrong edge that nothing downstream can catch.</c>
<l>if (EnergyPeak &lt; MinFocusEnergy)</l>
<l>    dev_display (Energy)</l>
<l>    disp_message (WindowHandle, 'REJECTED: nothing in focus - peak energy ' + EnergyPeak$'.1f' + ' &lt; ' + MinFocusEnergy + '. The frame has no chuck edge to measure; move the camera into focus and re-capture.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 3. Split the two sides on the energy map. LOOK HERE if the result is wrong - the reported</c>
<c>*    threshold should sit clear of both sides, not clipped to one of them.</c>
<l>if (ManualThreshold &lt; 0)</l>
<l>    binary_threshold (Energy, InFocusRaw, 'max_separability', 'light', UsedThreshold)</l>
<l>else</l>
<l>    UsedThreshold := ManualThreshold</l>
<l>    threshold (Energy, InFocusRaw, UsedThreshold, 255)</l>
<l>endif</l>
<l>dev_display (Energy)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (InFocusRaw)</l>
<l>disp_message (WindowHandle, '3: energy &gt;= ' + UsedThreshold + ' (green) - the in-focus side, before cleanup', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 4. Clean up to ONE solid region - the chuck FACE. Its outline is the inner edge, so step 5</c>
<c>*    still has to add the band.</c>
<l>closing_circle (InFocusRaw, InFocusClosed, CloseRadius)</l>
<l>opening_circle (InFocusClosed, InFocusOpened, OpenRadius)</l>
<l>connection (InFocusOpened, InFocusParts)</l>
<l>count_obj (InFocusParts, NumParts)</l>
<l>select_shape_std (InFocusParts, InFocusBiggest, 'max_area', 70)</l>
<l>fill_up (InFocusBiggest, InFocus)</l>
<l>area_center (InFocus, InFocusArea, InFocusRow, InFocusCol)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (InFocus)</l>
<l>disp_message (WindowHandle, '4: in-focus chuck face - ' + NumParts + ' component(s), largest covers ' + (100.0 * InFocusArea / (Width * Height))$'.1f' + '% of the frame', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 5. Add the near-black band, so the region reaches out to the OUTER edge. The cut is made on a</c>
<c>*    SMOOTHED grey image, or the chuck's dark pits come through as speckle, and is then</c>
<c>*    confined to a BandGuideRadius collar around the face so distant dark blobs cannot merge in.</c>
<l>mean_image (Gray, GraySmoothed, SmoothWindow, SmoothWindow)</l>
<l>threshold (GraySmoothed, DarkAll, 0, DarkThreshold)</l>
<l>dilation_circle (InFocus, BandGuide, BandGuideRadius)</l>
<l>intersection (DarkAll, BandGuide, Band)</l>
<l>area_center (Band, BandArea, BandRow, BandCol)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_color ('red')</l>
<l>dev_display (Band)</l>
<l>disp_message (WindowHandle, '5: black band, grey &lt;= ' + DarkThreshold + ' after smoothing, within ' + BandGuideRadius + ' px of the face (red) - area ' + BandArea, 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 5b. Face + band = the chuck out to its outer silhouette; the closing seals the seam. If the</c>
<c>*     band came back empty this collapses to the face alone and reports the INNER edge instead.</c>
<l>union2 (InFocus, Band, ChuckRaw)</l>
<l>closing_circle (ChuckRaw, ChuckClosed, BandCloseRadius)</l>
<l>connection (ChuckClosed, ChuckParts)</l>
<l>select_shape_std (ChuckParts, ChuckBiggest, 'max_area', 70)</l>
<l>fill_up (ChuckBiggest, Chuck)</l>
<l>area_center (Chuck, ChuckArea, ChuckRow, ChuckCol)</l>
<l>dev_display (Gray)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (Chuck)</l>
<l>disp_message (WindowHandle, '5b: face + band covers ' + (100.0 * ChuckArea / (Width * Height))$'.1f' + '% of the frame (was ' + (100.0 * InFocusArea / (Width * Height))$'.1f' + '% without the band)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 6. The chuck edge = that region's outline, minus the stretches that merely run along the</c>
<c>*    image frame. The clip severs those runs; the length filter drops the stubs it leaves.</c>
<l>gen_contour_region_xld (Chuck, RegionBorder, 'border')</l>
<l>clip_contours_xld (RegionBorder, ClippedBorder, BorderMargin, BorderMargin, Height - 1 - BorderMargin, Width - 1 - BorderMargin)</l>
<l>count_obj (ClippedBorder, NumClipped)</l>
<l>select_contours_xld (ClippedBorder, EdgeArcs, 'contour_length', MinArcLength, 1e9, -0.5, 0.5)</l>
<l>count_obj (EdgeArcs, NumArcs)</l>
<l>dev_display (Gray)</l>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (EdgeArcs)</l>
<l>disp_message (WindowHandle, '6: outline clipped into ' + NumClipped + ' piece(s), ' + NumArcs + ' longer than ' + MinArcLength + ' px (green)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<l>if (NumArcs &lt; 1)</l>
<l>    dev_display (Energy)</l>
<l>    disp_message (WindowHandle, 'FAILED: no arc survived. Check step 3 - if the threshold clipped to one side, the frame probably has no edge in view.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<c>* 6b. Circle fitted to the longest arc - a sanity read-out, not part of the result. The outer</c>
<c>*     edge fits to ~5 px RMS; ~21 px means the band was missed and this is the inner edge.</c>
<l>length_xld (EdgeArcs, ArcLengths)</l>
<l>tuple_sort_index (ArcLengths, LengthIdx)</l>
<l>select_obj (EdgeArcs, MainArc, LengthIdx[|LengthIdx| - 1] + 1)</l>
<l>fit_circle_contour_xld (MainArc, 'geohuber', -1, 0, 0, 3, 2, CircRow, CircCol, CircRadius, CircStartPhi, CircEndPhi, CircPointOrder)</l>
<l>get_contour_xld (MainArc, MainRow, MainCol)</l>
<l>Residual := sqrt((MainRow - CircRow) * (MainRow - CircRow) + (MainCol - CircCol) * (MainCol - CircCol)) - CircRadius</l>
<l>tuple_mean (Residual * Residual, MeanSquare)</l>
<l>FitRms := sqrt(MeanSquare)</l>
<l>dev_display (Gray)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (MainArc)</l>
<l>gen_circle_contour_xld (FitCircle, CircRow, CircCol, CircRadius, CircStartPhi, CircEndPhi, CircPointOrder, 1.0)</l>
<l>dev_set_color ('cyan')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (FitCircle)</l>
<l>disp_message (WindowHandle, '6b: longest arc = ' + ArcLengths[LengthIdx[|LengthIdx| - 1]]$'.0f' + ' px; fitted circle r=' + CircRadius$'.0f' + ' px (cyan), residual ' + FitRms$'.1f' + ' px RMS', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* 7. Edge point closest to the image centre, over all surviving arcs.</c>
<l>CenterRow := Height / 2.0</l>
<l>CenterCol := Width / 2.0</l>
<l>AllRow := []</l>
<l>AllCol := []</l>
<l>for K := 1 to NumArcs by 1</l>
<l>    select_obj (EdgeArcs, OneContour, K)</l>
<l>    get_contour_xld (OneContour, ContRow, ContCol)</l>
<l>    AllRow := [AllRow, ContRow]</l>
<l>    AllCol := [AllCol, ContCol]</l>
<l>endfor</l>
<l>Dist := sqrt((AllRow - CenterRow) * (AllRow - CenterRow) + (AllCol - CenterCol) * (AllCol - CenterCol))</l>
<l>tuple_sort_index (Dist, SortIdx)</l>
<l>Nearest := SortIdx[0]</l>
<l>NearRow := AllRow[Nearest]</l>
<l>NearCol := AllCol[Nearest]</l>
<l>NearDist := Dist[Nearest]</l>
<l>dev_display (Image)</l>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (EdgeArcs)</l>
<l>gen_cross_contour_xld (CenterCross, CenterRow, CenterCol, 60, 0.785)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (CenterCross)</l>
<l>gen_cross_contour_xld (NearCross, NearRow, NearCol, 60, 0.785)</l>
<l>dev_set_color ('red')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (NearCross)</l>
<l>disp_message (WindowHandle, '7: nearest edge point to centre = (' + NearRow$'.1f' + ', ' + NearCol$'.1f' + '),  dist=' + NearDist$'.1f' + ' px', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
