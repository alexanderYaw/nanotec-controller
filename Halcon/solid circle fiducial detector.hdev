<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="26.05.0.0">
<procedure name="main">
<interface/>
<body>
<c>* Solid-circle fiducial detector — mirrors Vision/SolidCircleDetector.cs stage for stage.</c>
<c>* The marker is a solid disk, distinctly brighter than a uniform background, with bright</c>
<c>* diagonal scribe lines nearby that may or may not cross it.</c>
<c>* </c>
<c>* The scene is NOT fixed, so there is no hand-tuned grey level here. Each frame accepts a</c>
<c>* BAND of workable cuts 11-15 levels wide, but no single statistic lands inside every band:</c>
<c>*   mono acA4024 frame  : band  60-130, otsu= 85, p99=130, p95=106</c>
<c>*   colour acA5472 clean: band 195-245, otsu=211, p99=255, p95=245</c>
<c>*   colour + dark strip : band 190-245, otsu=130 (WRONG - locks onto the strip), p97=192</c>
<c>* So we try otsu + the 99/97/95/93/90th percentiles and keep the ROUNDEST result. Scoring on</c>
<c>* circularity (rather than first-pass-wins) also lands mid-band, where the rim is truest.</c>
<c>* </c>
<c>* ClosingRadius : bridge the notch where a scribe line cuts the rim; &gt;= the widest gap</c>
<c>* OpenRadius    : sever a line where it CROSSES the disk; stay well below the disk radius.</c>
<c>*                 It need not erase a line outright - one left whole is elongated, so</c>
<c>*                 MinCircularity drops it (that is what happens on the mono frames, where</c>
<c>*                 the ~65 px lines outlive a radius-20 opening).</c>
<c>* MinCircularity: reject those surviving lines and any non-round blob</c>
<l>ClosingRadius := 25</l>
<l>OpenRadius := 20</l>
<l>MinCircularity := 0.85</l>
<l>MinArea := 5000</l>
<l>MaxArea := 1e9</l>
<c>* Load a test frame.</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>* read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/solid_circle_fiducial.png')</l>
<l>read_image (Image, 'C:/Users/AlexanderYawKaiMun/Desktop/images/capture_20260730_162849_830.bmp')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>dev_open_window (0, 0, 600, 450, 'black', WindowHandle)</l>
<l>set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>disp_message (WindowHandle, '0: input frame', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* Preprocess: mono passes through; a colour frame yields its RED channel (the markers were</c>
<c>* red-lit under the old colour camera, and luminance weights red only ~0.3).</c>
<l>count_channels (Image, Channels)</l>
<l>if (Channels &gt;= 3)</l>
<l>    access_channel (Image, Single, 1)</l>
<l>else</l>
<l>    copy_image (Image, Single)</l>
<l>endif</l>
<l>convert_image_type (Single, GrayByte, 'byte')</l>
<l>dev_display (GrayByte)</l>
<l>disp_message (WindowHandle, '1: single channel (byte)', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* Build the candidate cuts: otsu first, then descending percentiles of this frame's own</c>
<c>* histogram (the fiducial is always a small, bright minority of the frame).</c>
<l>binary_threshold (GrayByte, OtsuRegion, 'max_separability', 'light', OtsuThreshold)</l>
<l>gray_histo (GrayByte, GrayByte, AbsoluteHisto, RelativeHisto)</l>
<l>Candidates := [OtsuThreshold]</l>
<l>Percentiles := [99,97,95,93,90]</l>
<l>for P := 0 to |Percentiles| - 1 by 1</l>
<l>    Cum := 0</l>
<l>    for G := 0 to 255 by 1</l>
<l>        Cum := Cum + RelativeHisto[G]</l>
<l>        if (Cum &gt;= Percentiles[P] / 100.0)</l>
<l>            Candidates := [Candidates,G]</l>
<l>            break</l>
<l>        endif</l>
<l>    endfor</l>
<l>endfor</l>
<l>dev_display (GrayByte)</l>
<l>disp_message (WindowHandle, '2: candidate cuts = ' + sum(Candidates$'d' + ' '), 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
<c>* Run the pipeline at each candidate and keep the roundest surviving blob.</c>
<l>BestCirc := -1</l>
<l>BestThreshold := -1</l>
<l>gen_empty_obj (Best)</l>
<l>for I := 0 to |Candidates| - 1 by 1</l>
<l>    T := Candidates[I]</l>
<l>    threshold (GrayByte, Bright, T, 255)</l>
<l>    closing_circle (Bright, Closed, ClosingRadius)</l>
<l>    fill_up (Closed, FilledHoles)</l>
<l>    opening_circle (FilledHoles, Opened, OpenRadius)</l>
<l>    connection (Opened, Connected)</l>
<l>    count_obj (Connected, NumParts)</l>
<l>    Note := 'cut ' + T + ': '</l>
<l>    if (NumParts &lt; 1)</l>
<l>        Note := Note + 'nothing survived the opening'</l>
<l>    else</l>
<l>        select_shape (Connected, Round, ['circularity','area'], 'and', [MinCircularity,MinArea], [1.0,MaxArea])</l>
<l>        count_obj (Round, Count)</l>
<l>        if (Count &lt; 1)</l>
<l>            circularity (Connected, AllCirc)</l>
<l>            tuple_sort_index (AllCirc, AllSortIdx)</l>
<l>            select_obj (Connected, Roundest, AllSortIdx[|AllSortIdx| - 1] + 1)</l>
<l>            area_center (Roundest, NearArea, NearRow, NearCol)</l>
<l>            circularity (Roundest, NearCirc)</l>
<l>            Note := Note + 'FAILS gate - best was area=' + NearArea + ' circ=' + NearCirc$'.3f'</l>
<l>        else</l>
<l>            circularity (Round, RoundCirc)</l>
<l>            tuple_sort_index (RoundCirc, RoundSortIdx)</l>
<l>            select_obj (Round, Cand, RoundSortIdx[|RoundSortIdx| - 1] + 1)</l>
<l>            circularity (Cand, CandCirc)</l>
<l>            area_center (Cand, CandArea, CandRow, CandCol)</l>
<l>            Note := Note + 'area=' + CandArea + ' circ=' + CandCirc$'.3f' + ' centre=(' + CandRow$'.1f' + ',' + CandCol$'.1f' + ')'</l>
<l>            if (CandCirc &gt; BestCirc)</l>
<l>                BestCirc := CandCirc</l>
<l>                BestThreshold := T</l>
<l>                copy_obj (Cand, Best, 1, 1)</l>
<l>                Note := Note + '  &lt;- new best'</l>
<l>            endif</l>
<l>        endif</l>
<l>    endif</l>
<l>    dev_display (GrayByte)</l>
<l>    dev_set_draw ('margin')</l>
<l>    dev_set_line_width (2)</l>
<l>    dev_set_color ('green')</l>
<l>    dev_display (Opened)</l>
<l>    disp_message (WindowHandle, '3.' + I + ' ' + Note, 'window', 12, 12, 'yellow', 'false')</l>
<l>    stop ()</l>
<l>endfor</l>
<c>* Result overlay.</c>
<l>if (BestCirc &lt; 0)</l>
<l>    dev_display (Image)</l>
<l>    disp_message (WindowHandle, 'NO MARK at any candidate cut. Check step 2, or loosen MinCircularity/MinArea.', 'window', 12, 12, 'red', 'false')</l>
<l>    stop ()</l>
<l>    return ()</l>
<l>endif</l>
<l>area_center (Best, Area, Row, Column)</l>
<l>Radius := sqrt(Area / 3.14159265358979)</l>
<l>gen_contour_region_xld (Best, Border, 'border')</l>
<l>gen_cross_contour_xld (Cross, Row, Column, 60, 0.785398)</l>
<l>dev_display (Image)</l>
<l>dev_set_line_width (2)</l>
<l>dev_set_color ('red')</l>
<l>dev_display (Border)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (Cross)</l>
<l>disp_message (WindowHandle, 'centre = (' + Row$'.1f' + ', ' + Column$'.1f' + ')  r=' + Radius$'.1f' + ' px  @ cut ' + BestThreshold + ' (circ ' + BestCirc$'.3f' + ')', 'window', 12, 12, 'yellow', 'false')</l>
<l>stop ()</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
